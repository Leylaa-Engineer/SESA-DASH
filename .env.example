# MySQL connection string for the empty production database.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DB_NAME
DATABASE_SSL=true
DB_CONNECTION_LIMIT=5

# Firebase Admin credentials used only by Vercel API functions to verify client ID tokens.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Server-side registration codes; do not expose these as VITE_ variables.
RESPONSIBLE_SIGNUP_CODE=replace-me
ADMIN_SIGNUP_CODE=replace-me
